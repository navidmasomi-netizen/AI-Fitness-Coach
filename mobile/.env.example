# Mobile environment variables
#
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored and must never be committed.
#
# EXPO_PUBLIC_* variables are bundled into the app at build time.
# They are visible to anyone who inspects the bundle.
# Do NOT use them for secrets, tokens, or private keys.

# API base URL for the mobile app.
#
# Expo Go (simulator or physical device):
#   Usually not required. The Metro dev server host is auto-detected.
#
# EAS development builds on a physical device:
#   Required. Set this to your development machine's LAN IP.
#
# Staging and production:
#   Set this via EAS environment variables — do not commit real URLs here.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:3001/api
