{
  "expo": {
    "name": "Runpuy",
    "slug": "runpuy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.runpuy.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.runpuy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0D1417",
        "foregroundImage": "./assets/brand/adaptive-icon-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "024efd93-a0e8-48aa-9395-2816c866d7cf"
      }
    },
    "owner": "runpuy-app"
  }
}
